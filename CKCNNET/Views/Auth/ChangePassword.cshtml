@model User

@{
    ViewData["Title"] = "Đổi Mật Khẩu";
}

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="bi bi-key"></i> Đổi Mật Khẩu
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle"></i> <strong>Lỗi!</strong> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle"></i> <strong>Thành công!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label for="currentPassword" class="form-label">
                                <i class="bi bi-lock"></i> Mật khẩu hiện tại
                            </label>
                            <input type="password" class="form-control" id="currentPassword" name="currentPassword"
                                   placeholder="Nhập mật khẩu hiện tại" required>
                            <small class="form-text text-muted">Nhập mật khẩu bạn đang sử dụng để xác minh</small>
                        </div>

                        <hr>

                        <div class="mb-3">
                            <label for="newPassword" class="form-label">
                                <i class="bi bi-key"></i> Mật khẩu mới
                            </label>
                            <input type="password" class="form-control" id="newPassword" name="newPassword"
                                   placeholder="Nhập mật khẩu mới (tối thiểu 8 ký tự)" required>
                            <small class="form-text text-muted">Mật khẩu phải chứa ít nhất 8 ký tự</small>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">
                                <i class="bi bi-lock-check"></i> Xác nhận mật khẩu mới
                            </label>
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                                   placeholder="Nhập lại mật khẩu mới" required>
                        </div>

                        <hr>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning flex-grow-1">
                                <i class="bi bi-check-circle"></i> Đổi Mật Khẩu
                            </button>
                            <a href="@Url.Action("Profile")" class="btn btn-secondary flex-grow-1">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="alert alert-info mt-4">
                <strong><i class="bi bi-info-circle"></i> Lưu ý An Toàn:</strong>
                <ul class="mb-0 ms-2">
                    <li><strong>Mật khẩu hiện tại:</strong> Phải nhập chính xác mật khẩu bạn đang sử dụng</li>
                    <li><strong>Mật khẩu mới:</strong> Phải có tối thiểu 8 ký tự</li>
                    <li><strong>Khác mật khẩu cũ:</strong> Mật khẩu mới phải khác mật khẩu hiện tại</li>
                    <li><strong>Xác nhận:</strong> Nhập lại mật khẩu mới phải khớp với mật khẩu mới</li>
                </ul>
            </div>

            <div class="alert alert-warning">
                <strong><i class="bi bi-exclamation-triangle"></i> Cảnh báo:</strong>
                <p class="mb-0">Sau khi đổi mật khẩu thành công, mật khẩu hiện tại không còn sử dụng được nữa. Nếu bạn quên mật khẩu, hãy liên hệ với Admin.</p>
            </div>

            <div class="mt-3 text-center">
                <a href="@Url.Action("Profile")" class="link-secondary">← Quay lại hồ sơ</a>
            </div>
        </div>
    </div>
</div>

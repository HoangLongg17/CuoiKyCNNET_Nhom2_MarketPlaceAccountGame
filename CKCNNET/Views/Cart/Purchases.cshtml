@model IEnumerable<Purchase>

@{
    ViewData["Title"] = "Lịch sử mua hàng";
    ViewData["ShowGlobalAlerts"] = false;
}

<div class="container mt-4">
    <h2 class="mb-4">📜 Lịch sử mua</h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var p in Model)
            {
                <div class="col-lg-6 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@p.GameAccount?.Game?.Name</strong>
                                <div class="small text-muted">Người bán: @p.GameAccount?.Seller?.Username</div>
                            </div>
                            <div class="text-end">
                                <span class="badge @(p.Status == "Completed" ? "bg-success" : (p.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark"))">
                                    @p.Status
                                </span>
                                <div class="small text-muted">@p.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>Giá:</strong> <span class="text-success">@p.Amount.ToString("N0") VND</span></p>
                            <p class="mb-1"><strong>Mô tả ngắn:</strong> @p.GameAccount?.Description</p>

                            <div class="mt-3 d-flex gap-2">
                                <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#purchaseModal@(p.Id)">
                                    👁️ Xem chi tiết đơn
                                </button>
                                <a href="@Url.Action("GameDetails", "Home", new { gameId = p.GameAccount?.Game?.Id })" class="btn btn-outline-secondary">
                                    🔎 Xem game
                                </a>
                            </div>
                        </div>
                        <div class="card-footer">
                            <small class="text-muted">Mã giao dịch: #@p.Id</small>
                        </div>
                    </div>
                </div>

                <!-- Modal chi tiết đơn -->
                <div class="modal fade" id="purchaseModal@(p.Id)" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Chi tiết Đơn hàng - #@p.Id</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Tựa game</strong></div>
                                    <div class="col-sm-8">@p.GameAccount?.Game?.Name</div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Giá</strong></div>
                                    <div class="col-sm-8 text-success fw-bold">@p.Amount.ToString("N0") VND</div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Người bán</strong></div>
                                    <div class="col-sm-8">
                                        @p.GameAccount?.Seller?.Username 
                                        <br>
                                        <small class="text-muted">
                                            Email: @p.GameAccount?.Seller?.Email<br>
                                            Số điện thoại: @p.GameAccount?.Seller?.PhoneNumber<br>
                                            @if (!string.IsNullOrEmpty(p.GameAccount?.Seller?.BankAccount))
                                            {
                                                <span>STK: @p.GameAccount.Seller.BankAccount (@p.GameAccount.Seller.BankAccountHolder)</span>
                                            }
                                        </small>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Mô tả</strong></div>
                                    <div class="col-sm-8">@p.GameAccount?.Description</div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Thông tin liên hệ</strong></div>
                                    <div class="col-sm-8">@(!string.IsNullOrEmpty(p.GameAccount?.ContactInfo) ? p.GameAccount.ContactInfo : "Không có")</div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Trạng thái đơn</strong></div>
                                    <div class="col-sm-8">@p.Status (@(p.CompletedDate.HasValue ? p.CompletedDate.Value.ToString("dd/MM/yyyy HH:mm") : "-"))</div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Ngày mua</strong></div>
                                    <div class="col-sm-8">@p.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>

                                @{
                                    var currentUserId = Context.Session.GetInt32("UserId");
                                    var currentUserRole = Context.Session.GetString("UserRole");
                                    var proofMap = ViewBag.PaymentProofs as System.Collections.Generic.Dictionary<int, string?>;
                                    string? proofFile = null;
                                    if (proofMap != null && proofMap.ContainsKey(p.Id))
                                    {
                                        proofFile = proofMap[p.Id];
                                    }
                                }

                                @if (p.Status == "Pending")
                                {
                                    <div class="alert alert-info mt-3">
                                        <strong>ℹ️ Quá trình thanh toán đang chờ Seller kiểm tra</strong>
                                        <p class="mb-1">Nếu bạn đã chuyển khoản, vui lòng tải ảnh minh chứng để Seller kiểm tra.</p>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-sm-4"><strong>Ngân hàng người bán</strong></div>
                                        <div class="col-sm-8">
                                            <div><strong>Chủ tài khoản:</strong> @(p.GameAccount?.Seller?.BankAccountHolder ?? "Không có")</div>
                                            <div><strong>Số tài khoản:</strong> @(p.GameAccount?.Seller?.BankAccount ?? "Không có")</div>
                                        </div>
                                    </div>

                                    @if (currentUserId == p.BuyerId)
                                    {
                                        <form method="post" asp-action="UploadProof" enctype="multipart/form-data" class="mb-3">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="purchaseId" value="@p.Id" />
                                            <div class="mb-2">
                                                <label class="form-label">Tải ảnh minh chứng chuyển khoản</label>
                                                <input type="file" name="proofImage" class="form-control" accept="image/*" required />
                                            </div>
                                            <button type="submit" class="btn btn-primary">⬆️ Tải lên</button>
                                        </form>
                                    }

                                    @if (!string.IsNullOrEmpty(proofFile))
                                    {
                                        <div class="mt-3">
                                            <p><strong>Ảnh minh chứng đã gửi</strong></p>
                                            <img src="~/uploads/payments/@proofFile" class="img-fluid border" alt="Proof" />
                                        </div>
                                    }
                                }

                                @if (p.Status == "Pending" && p.GameAccount?.SellerId == currentUserId)
                                {
                                    <hr />
                                    <h6>📥 Phiên chờ kiểm tra (bởi Seller)</h6>

                                    @if (!string.IsNullOrEmpty(proofFile))
                                    {
                                        <div class="mb-3">
                                            <p class="mb-1"><strong>Ảnh minh chứng người mua gửi</strong></p>
                                            <img src="~/uploads/payments/@proofFile" class="img-fluid border" alt="Proof" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-secondary">Chưa có ảnh minh chứng nào được gửi.</div>
                                    }

                                    <div class="d-flex gap-2 mt-3">
                                        <form method="post" asp-action="ApprovePurchase" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="purchaseId" value="@p.Id" />
                                            <button type="submit" class="btn btn-success" onclick="return confirm('Xác nhận đồng ý và hoàn tất giao dịch?');">
                                                ✓ Đồng ý
                                            </button>
                                        </form>

                                        <button class="btn btn-danger" data-bs-toggle="collapse" data-bs-target="#rejectBox@(p.Id)">
                                            ✗ Từ chối
                                        </button>
                                    </div>

                                    <div class="collapse mt-3" id="rejectBox@(p.Id)">
                                        <form method="post" asp-action="RejectPurchase">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="purchaseId" value="@p.Id" />
                                            <div class="mb-2">
                                                <label class="form-label">Lý do từ chối (hiển thị cho người mua)</label>
                                                <textarea name="reason" class="form-control" rows="3" required></textarea>
                                            </div>
                                            <button type="submit" class="btn btn-danger">Gửi lý do & Từ chối</button>
                                        </form>
                                    </div>
                                }

                                @if (p.Status == "Completed")
                                {
                                    <div class="alert alert-warning mt-3">
                                        <strong>⚠️ Thông tin đăng nhập (nếu có)</strong>
                                        <p class="mb-0"><strong>Username:</strong> @(string.IsNullOrEmpty(p.AccountUsername) ? "Không có" : p.AccountUsername)</p>
                                        <p class="mb-0"><strong>Password:</strong> @(string.IsNullOrEmpty(p.AccountPassword) ? "Không có" : p.AccountPassword)</p>
                                    </div>
                                }

                                @if (p.Status == "Rejected")
                                {
                                    <div class="alert alert-danger mt-3">
                                        <strong>✖️ Phiên mua đã bị hủy bởi người bán</strong>
                                        <p class="mb-0">Lý do: @(string.IsNullOrEmpty(p.RejectionReason) ? "Không có" : p.RejectionReason)</p>
                                    </div>
                                }
                            </div>
                            <div class="modal-footer">
                                @if (p.Status == "Rejected")
                                {
                                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" 
                                            data-bs-target="#reportModal@(p.Id)" data-bs-dismiss="modal">
                                        ⚠️ Báo cáo cho Admin
                                    </button>
                                }
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Report -->
                @if (p.Status == "Rejected")
                {
                    <div class="modal fade" id="reportModal@(p.Id)" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-warning">
                                    <h5 class="modal-title">⚠️ Báo cáo đơn mua - #@p.Id</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <form method="post" action="@Url.Action("ReportPurchase", "Cart")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="purchaseId" value="@p.Id" />
                                    
                                    <div class="modal-body">
                                        <div class="alert alert-info" role="alert">
                                            <strong>ℹ️ Khi báo cáo được duyệt:</strong>
                                            <ul class="mb-0 mt-2">
                                                <li>Admin sẽ liên hệ với seller</li>
                                                <li>Yêu cầu seller hoàn tiền cho bạn</li>
                                                <li>Bạn cần liên hệ lại với seller nếu không nhận được tiền</li>
                                                <li>Seller vi phạm có thể bị xử phạt/khóa tài khoản</li>
                                            </ul>
                                        </div>

                                        <div class="mb-3 bg-light p-3 rounded">
                                            <strong>📞 Thông tin liên hệ Seller:</strong>
                                            <p class="mb-1">Username: @p.GameAccount?.Seller?.Username</p>
                                            <p class="mb-1">Email: @p.GameAccount?.Seller?.Email</p>
                                            <p class="mb-1">Số điện thoại: @p.GameAccount?.Seller?.PhoneNumber</p>
                                            @if (!string.IsNullOrEmpty(p.GameAccount?.Seller?.BankAccount))
                                            {
                                                <p class="mb-0">
                                                    STK: <span class="badge bg-secondary">@p.GameAccount.Seller.BankAccount</span>
                                                    <br>
                                                    <small>Chủ TK: @p.GameAccount.Seller.BankAccountHolder</small>
                                                </p>
                                            }
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label"><strong>🚩 Lý do báo cáo</strong></label>
                                            <select class="form-select" name="reason" required>
                                                <option value="">-- Chọn lý do --</option>
                                                <option value="Seller đã nhận tiền nhưng từ chối">Seller đã nhận tiền nhưng từ chối</option>
                                                <option value="Account không như mô tả">Account không như mô tả</option>
                                                <option value="Account đã bị khóa">Account đã bị khóa</option>
                                                <option value="Lý do khác">Lý do khác</option>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label"><strong>📝 Mô tả chi tiết</strong></label>
                                            <textarea class="form-control" name="description" rows="4" 
                                                      placeholder="Mô tả chi tiết vấn đề để giúp admin xử lý..." required></textarea>
                                            <small class="text-muted">VD: Đã thanh toán 500K ngày 10/5, seller đã xác nhận nhưng sau đó từ chối không cung cấp tài khoản</small>
                                        </div>
                                    </div>

                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                        <button type="submit" class="btn btn-warning">📤 Gửi báo cáo</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Chưa có giao dịch mua nào. <a href="@Url.Action("Index", "Home")">Mua ngay</a>
        </div>
    }
</div>
@model IEnumerable<Purchase>

@{
    ViewData["Title"] = "Lịch sử mua hàng";
    ViewData["ShowGlobalAlerts"] = false;
}

<div class="container mt-4">
    <h2 class="mb-4">📜 Lịch sử mua</h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var p in Model)
            {
                <div class="col-lg-6 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@p.GameAccount?.Game?.Name</strong>
                                <div class="small text-muted">Người bán: @p.GameAccount?.Seller?.Username</div>
                            </div>
                            <div class="text-end">
                                <span class="badge @(p.Status == "Completed" ? "bg-success" : "bg-secondary")">
                                    @p.Status
                                </span>
                                <div class="small text-muted">@p.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>Giá:</strong> <span class="text-success">@p.Amount.ToString("N0") VND</span></p>
                            <p class="mb-1"><strong>Mô tả ngắn:</strong> @p.GameAccount?.Description</p>

                            <div class="mt-3 d-flex gap-2">
                                <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#purchaseModal@(p.Id)">
                                    👁️ Xem chi tiết đơn
                                </button>
                                <a href="@Url.Action("GameDetails", "Home", new { gameId = p.GameAccount?.Game?.Id })" class="btn btn-outline-secondary">
                                    🔎 Xem game
                                </a>
                            </div>
                        </div>
                        <div class="card-footer">
                            <small class="text-muted">Mã giao dịch: #@p.Id</small>
                        </div>
                    </div>
                </div>

                <!-- Modal chi tiết đơn -->
                <div class="modal fade" id="purchaseModal@(p.Id)" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Chi tiết Đơn hàng - #@p.Id</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Tựa game</strong></div>
                                    <div class="col-sm-8">@p.GameAccount?.Game?.Name</div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Giá</strong></div>
                                    <div class="col-sm-8 text-success fw-bold">@p.Amount.ToString("N0") VND</div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Người bán</strong></div>
                                    <div class="col-sm-8">@p.GameAccount?.Seller?.Username (@p.GameAccount?.Seller?.Email)</div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Mô tả</strong></div>
                                    <div class="col-sm-8">@p.GameAccount?.Description</div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Thông tin liên hệ</strong></div>
                                    <div class="col-sm-8">@(!string.IsNullOrEmpty(p.GameAccount?.ContactInfo) ? p.GameAccount.ContactInfo : "Không có")</div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Trạng thái đơn</strong></div>
                                    <div class="col-sm-8">@p.Status (@(p.CompletedDate.HasValue ? p.CompletedDate.Value.ToString("dd/MM/yyyy HH:mm") : "-"))</div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Ngày mua</strong></div>
                                    <div class="col-sm-8">@p.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>

                                @if (p.Status == "Completed")
                                {
                                    <div class="alert alert-warning mt-3">
                                        <strong>⚠️ Thông tin đăng nhập (nếu có)</strong>
                                        <p class="mb-0"><strong>Username:</strong> @(string.IsNullOrEmpty(p.AccountUsername) ? "Không có" : p.AccountUsername)</p>
                                        <p class="mb-0"><strong>Password:</strong> @(string.IsNullOrEmpty(p.AccountPassword) ? "Không có" : p.AccountPassword)</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info mt-3">
                                        Thông tin đăng nhập sẽ được cập nhật khi đơn hoàn tất.
                                    </div>
                                }
                            </div>
                            <div class="modal-footer">
                                <a href="@Url.Action("GameDetails", "Home", new { gameId = p.GameAccount?.Game?.Id })" class="btn btn-outline-secondary">
                                    🔎 Xem trang game
                                </a>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /Modal -->
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Chưa có giao dịch mua nào. <a href="@Url.Action("Index", "Home")">Mua ngay</a>
        </div>
    }
</div>
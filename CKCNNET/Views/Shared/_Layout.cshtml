<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Game Account Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/custom-style.css">
</head>

<body style="display: flex; flex-direction: column; min-height: 100vh;">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">🎮 GameAccount</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">Trang chủ</a>
                    </li>

                    @if (!string.IsNullOrEmpty(Context.Session.GetString("UserRole")))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Cart")">🛒 Giỏ hàng</a>
                        </li>

                        @if (Context.Session.GetString("UserRole") == "Seller" || 
                             Context.Session.GetString("UserRole") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("MyListings", "GameAccount")">📋 Danh sách Account</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-success btn-sm text-white ms-2" href="@Url.Action("Create", "GameAccount")">
                                    ➕ Đăng bán
                                </a>
                            </li>
                        }

                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Dashboard", "Admin")">⚙️ Admin Panel</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("PurchaseReports", "Admin")">
                                    <i class="bi bi-exclamation-triangle"></i> 
                                    <span>Báo cáo mua hàng</span>
                                    @if (ViewBag.PendingReportsCount > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill">@ViewBag.PendingReportsCount</span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("ChangePassword", "Auth")">
                                    <i class="bi bi-key"></i> 
                                    <span>Đổi mật khẩu</span>
                                </a>
                            </li>
                        }

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <span class="user-badge">@Context.Session.GetString("Username")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("Profile", "Auth")">👤 Hồ sơ cá nhân</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Purchases", "Cart")">📜 Lịch sử mua</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Logout", "Auth")">🚪 Đăng xuất</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Auth")">Đăng nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Register", "Auth")">Đăng ký</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hiển thị thông báo từ TempData (chỉ hiển thị nếu view không tắt bằng ViewData["ShowGlobalAlerts"] = false) -->
    @{
        var showAlertsObj = ViewData["ShowGlobalAlerts"];
        var showAlerts = true;
        if (showAlertsObj is bool b) { showAlerts = b; }
    }
    @if (showAlerts)
    {
        <div class="container mt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    @TempData["WarningMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    @TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    }

    <main style="flex: 1;">
        @RenderBody()
    </main>

    <footer style="margin-top: auto; padding-top: 50px;">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h5>Về chúng tôi</h5>
                    <p>Sàn giao dịch account game uy tín và an toàn.</p>
                </div>
                <div class="col-md-4">
                    <h5>Liên hệ</h5>
                    <p>Email: info@gameaccount.com</p>
                    <p>Hotline: 0123 456 789</p>
                </div>
                <div class="col-md-4">
                    <h5>Theo dõi chúng tôi</h5>
                    <p>Facebook | Twitter | Instagram</p>
                </div>
            </div>
            <hr>
            <p class="text-center text-muted">&copy; 2024 Game Account Store. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>

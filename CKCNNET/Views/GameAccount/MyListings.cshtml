@model IEnumerable<GameAccount>

@{
    ViewData["Title"] = "Danh sách Account của tôi";
    ViewData["ShowGlobalAlerts"] = false;
}

<div class="container-fluid bg-info text-white py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1>📋 Danh sách Account của tôi</h1>
                <p class="mb-0">Quản lý các account đang bán</p>
            </div>
            <a href="@Url.Action("Create", "GameAccount")" class="btn btn-light btn-lg">
                ➕ Đăng bán Account mới
            </a>
        </div>
    </div>
</div>

<div class="container mt-5 mb-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            ✅ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            ❌ @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Game</th>
                        <th>Mô tả</th>
                        <th>Giá</th>
                        <th>Trạng thái</th>
                        <th>Tình trạng</th>
                        <th>Ngày đăng</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Model)
                    {
                        <tr>
                            <td>
                                <strong>@account.Game.Name</strong>
                            </td>
                            <td>
                                <small>@(account.Description.Length > 40 ? account.Description.Substring(0, 40) + "..." : account.Description)</small>
                            </td>
                            <td>
                                <span class="badge bg-success">@account.Price.ToString("N0") VND</span>
                            </td>
                            <td>
                                @{
                                    var latestPurchase = account.Purchases?.OrderByDescending(p => p.PurchaseDate).FirstOrDefault();
                                }

                                @if (latestPurchase != null)
                                {
                                    if (latestPurchase.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">⏳ Pending (@(latestPurchase.Buyer?.Username ?? "Buyer"))</span>
                                    }
                                    else if (latestPurchase.Status == "Completed")
                                    {
                                        <span class="badge bg-success">✓ Completed</span>
                                    }
                                    else if (latestPurchase.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">✗ Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@latestPurchase.Status</span>
                                    }
                                }
                                else
                                {
                                    if (account.IsSold)
                                    {
                                        <span class="badge bg-secondary">Đã bán</span>
                                    }
                                    else if (!account.IsApproved)
                                    {
                                        <span class="badge bg-warning">⏳ Chờ duyệt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">✓ Đang bán</span>
                                    }
                                }
                            </td>
                            <td>
                                @* Tình trạng (availability) ưu tiên Pending để seller biết đang có đơn chờ, sau đó IsSold *@
                                @if (account.Purchases?.Any(p => p.Status == "Pending") == true)
                                {
                                    <span class="badge bg-warning text-dark">Có đơn chờ</span>
                                }
                                else if (account.IsSold)
                                {
                                    <span class="badge bg-secondary">Bán rồi</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Còn</span>
                                }
                            </td>
                            <td>
                                <small>@account.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    @if (!account.IsSold)
                                    {
                                        <a href="@Url.Action("Edit", "GameAccount", new { id = account.Id })" 
                                           class="btn btn-outline-primary">
                                            ✏️ Sửa
                                        </a>
                                        <form method="post" action="@Url.Action("Delete", "GameAccount", new { id = account.Id })" 
                                              style="display:inline;">
                                            <button type="submit" class="btn btn-outline-danger" 
                                                    onclick="return confirm('Bạn chắc chắn muốn xóa?')">
                                                🗑️ Xóa
                                            </button>
                                        </form>
                                    }
                                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#accountModal@(account.Id)">
                                        👁️ Xem
                                    </button>
                                </div>
                            </td>
                        </tr>

                        <!-- Modal chi tiết cho từng account -->
                        <div class="modal fade" id="accountModal@(account.Id)" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Chi tiết Account - @account.Game?.Name</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row mb-3">
                                            <div class="col-md-4"><strong>Giá</strong></div>
                                            <div class="col-md-8 text-success fw-bold">@account.Price.ToString("N0") VND</div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-4"><strong>Mô tả</strong></div>
                                            <div class="col-md-8">@account.Description</div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-4"><strong>Người bán</strong></div>
                                            <div class="col-md-8">@account.Seller?.Username (@account.Seller?.Email)</div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(account.Username))
                                        {
                                            <div class="row mb-3">
                                                <div class="col-md-4"><strong>Username</strong></div>
                                                <div class="col-md-8">@account.Username</div>
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(account.Password))
                                        {
                                            <div class="row mb-3">
                                                <div class="col-md-4"><strong>Password</strong></div>
                                                <div class="col-md-8">@account.Password</div>
                                            </div>
                                        }

                                        <div class="row mb-3">
                                            <div class="col-md-4"><strong>Thông tin liên hệ</strong></div>
                                            <div class="col-md-8">@(!string.IsNullOrEmpty(account.ContactInfo) ? account.ContactInfo : "Không có")</div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-4"><strong>Trạng thái</strong></div>
                                            <div class="col-md-8">
                                                @if (latestPurchase != null)
                                                {
                                                    <div>
                                                        <strong>Giao dịch gần nhất:</strong>
                                                        <div>
                                                            <span class="badge @(latestPurchase.Status == "Completed" ? "bg-success" : (latestPurchase.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark"))">
                                                                @latestPurchase.Status
                                                            </span>
                                                            <small class="text-muted ms-2">#@latestPurchase.Id — @latestPurchase.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</small>
                                                        </div>
                                                        <div class="small text-muted">Người mua: @latestPurchase.Buyer?.Username (@latestPurchase.Buyer?.Email)</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @if (account.IsSold)
                                                    {
                                                        <span class="badge bg-secondary">Đã bán</span>
                                                    }
                                                    else if (!account.IsApproved)
                                                    {
                                                        <span class="badge bg-warning">⏳ Chờ duyệt</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">✓ Đang bán</span>
                                                    }
                                                }
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-md-4"><strong>Ngày đăng</strong></div>
                                            <div class="col-md-8">@account.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        </div>

                                        @* Seller: show pending purchases & proofs here (Seller duyệt minh chứng ở đây) *@
                                        @{
                                            var currentUserId = Context.Session.GetInt32("UserId");
                                            var pendingPurchases = account.Purchases?.Where(p => p.Status == "Pending").OrderByDescending(p => p.PurchaseDate).ToList() ?? new List<Purchase>();
                                        }

                                        @if (pendingPurchases.Any() && currentUserId == account.SellerId)
                                        {
                                            <hr />
                                            <h6>📥 Đơn chờ kiểm tra</h6>

                                            <div class="list-group">
                                                @foreach (var p in pendingPurchases)
                                                {
                                                    var proof = account.PaymentProofs?.FirstOrDefault(pp => pp.BuyerId == p.BuyerId);
                                                    <div class="list-group-item mb-2">
                                                        <div class="d-flex justify-content-between align-items-start">
                                                            <div>
                                                                <div><strong>Người mua:</strong> @p.Buyer?.Username (@p.Buyer?.Email)</div>
                                                                <div class="small text-muted">Mã #@p.Id — @p.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</div>
                                                            </div>
                                                            <div class="text-end">
                                                                @if (!string.IsNullOrEmpty(proof?.FileName))
                                                                {
                                                                    <a href="~/uploads/payments/@proof.FileName" target="_blank" class="btn btn-sm btn-outline-primary mb-2">🔎 Xem minh chứng</a>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted d-block mb-2">Chưa có minh chứng</span>
                                                                }

                                                                <div class="d-flex gap-2 justify-content-end">
                                                                    <form method="post" action="@Url.Action("ApprovePurchase", "Cart")" class="d-inline">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="purchaseId" value="@p.Id" />
                                                                        <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Xác nhận đồng ý và hoàn tất giao dịch cho đơn #@p.Id?');">✓ Đồng ý</button>
                                                                    </form>

                                                                    <button class="btn btn-danger btn-sm" data-bs-toggle="collapse" data-bs-target="#rejectBox@(account.Id)_@(p.Id)">✗ Từ chối</button>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="collapse mt-3" id="rejectBox@(account.Id)_@(p.Id)">
                                                            <form method="post" action="@Url.Action("RejectPurchase", "Cart")">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="purchaseId" value="@p.Id" />
                                                                <div class="mb-2">
                                                                    <label class="form-label">Lý do từ chối (hiển thị cho người mua)</label>
                                                                    <textarea name="reason" class="form-control" rows="3" required></textarea>
                                                                </div>
                                                                <button type="submit" class="btn btn-danger btn-sm">Gửi lý do & Từ chối</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (currentUserId == account.SellerId)
                                        {
                                            <div class="alert alert-secondary">Không có đơn chờ kiểm tra cho account này.</div>
                                        }
                                    </div>
                                    <div class="modal-footer">
                                        @if (!account.IsSold)
                                        {
                                            <a href="@Url.Action("Edit", "GameAccount", new { id = account.Id })" class="btn btn-primary">
                                                ✏️ Sửa
                                            </a>
                                            <form method="post" action="@Url.Action("Delete", "GameAccount", new { id = account.Id })" style="display:inline;">
                                                <button type="submit" class="btn btn-danger" onclick="return confirm('Xác nhận xóa account này?');">
                                                    🗑️ Xóa
                                                </button>
                                            </form>
                                        }
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- /Modal -->
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5" role="alert">
            <h5>📦 Chưa có account nào</h5>
            <p class="mb-3">Bạn chưa đăng bán account nào cả. Hãy bắt đầu bằng cách đăng bán account đầu tiên!</p>
            <a href="@Url.Action("Create", "GameAccount")" class="btn btn-primary btn-lg">
                ➕ Đăng bán Account Ngay
            </a>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .btn-group-sm .btn {
        font-size: 0.85rem;
        padding: 0.35rem 0.5rem;
    }
</style>
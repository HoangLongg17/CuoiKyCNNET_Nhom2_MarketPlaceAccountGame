@model GameAccount

@{
    ViewData["Title"] = "Sửa Account Game";
}

<div class="container-fluid bg-primary text-white py-4">
    <div class="container">
        <h1>✏️ Sửa Account Game</h1>
    </div>
</div>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg">
                <div class="card-body p-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @foreach (var modelState in ViewData.ModelState.Values)
                            {
                                @foreach (var error in modelState.Errors)
                                {
                                    <p class="mb-0">❌ @error.ErrorMessage</p>
                                }
                            }
                        </div>
                    }

                    <form method="post" class="needs-validation" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="mb-4">
                            <label for="gameId" class="form-label"><strong>🎮 Game</strong></label>
                            <select class="form-select form-select-lg" id="gameId" name="gameId">
                                @foreach (var game in ViewBag.Games)
                                {
                                    <option value="@game.Id" selected="@(game.Id == Model.GameId)">@game.Name</option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label for="description" class="form-label"><strong>📝 Mô tả</strong></label>
                            <textarea class="form-control form-control-lg" id="description" name="description" rows="4">@Model.Description</textarea>
                        </div>

                        <div class="mb-4">
                            <label for="price" class="form-label"><strong>💰 Giá (VND)</strong></label>
                            <input type="number" class="form-control form-control-lg" id="price" name="price" value="@Model.Price">
                        </div>

                        <hr class="my-4">

                        <div class="mb-4">
                            <label for="username" class="form-label">Tên tài khoản</label>
                            <input type="text" class="form-control form-control-lg" id="username" name="username" value="@Model.Username">
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label">Mật khẩu</label>
                            <input type="password" class="form-control form-control-lg" id="password" name="password" placeholder="Để trống nếu không muốn thay đổi">
                        </div>

                        <div class="mb-4">
                            <label for="contactInfo" class="form-label"><strong>📞 Liên hệ</strong></label>
                            <input type="text" class="form-control form-control-lg" id="contactInfo" name="contactInfo" value="@Model.ContactInfo">
                        </div>

                        <hr class="my-4">

                        <!-- Hiển thị ảnh hiện có -->
                        @if (Model.Images != null && Model.Images.Any())
                        {
                            <div class="mb-4">
                                <label class="form-label"><strong>🖼️ Ảnh hiện có:</strong></label>
                                <div class="row">
                                    @foreach (var image in Model.Images)
                                    {
                                        <div class="col-md-4 mb-3">
                                            <div class="card">
                                                <img src="@image.ImagePath" class="card-img-top" style="height: 150px; object-fit: cover;">
                                                <div class="card-body p-2">
                                                    <button type="button" class="btn btn-sm btn-danger w-100" 
                                                            onclick="deleteImage(@image.Id, @Model.Id)">
                                                        🗑️ Xóa
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <hr class="my-4">
                        }

                        <!-- Thêm ảnh mới -->
                        <div class="mb-4">
                            <label for="images" class="form-label"><strong>🖼️ Thêm ảnh mới (Tùy chọn)</strong></label>
                            <input type="file" class="form-control form-control-lg" id="images" name="images" multiple accept="image/*">
                            <small class="text-muted d-block mt-2">Tối đa 10 ảnh, mỗi ảnh dưới 5MB</small>
                            <div id="imagePreview" class="mt-3"></div>
                        </div>

                        <div class="d-flex gap-2 mt-5">
                            <a href="@Url.Action("MyListings", "GameAccount")" class="btn btn-secondary btn-lg flex-grow-1">
                                ← Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                💾 Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('images').addEventListener('change', function(e) {
    const preview = document.getElementById('imagePreview');
    preview.innerHTML = '';
    
    Array.from(this.files).forEach((file, index) => {
        if (index < 10) {
            const reader = new FileReader();
            reader.onload = function(event) {
                const img = document.createElement('img');
                img.src = event.target.result;
                img.style.width = '100px';
                img.style.height = '100px';
                img.style.margin = '5px';
                img.style.borderRadius = '5px';
                img.style.border = '1px solid #ddd';
                preview.appendChild(img);
            };
            reader.readAsDataURL(file);
        }
    });
});

function deleteImage(imageId, accountId) {
    if (!confirm('Xóa ảnh này?')) return;
    
    fetch(`/GameAccount/DeleteImage`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: `imageId=${imageId}&accountId=${accountId}`
    })
    .then(response => {
        if (response.ok) {
            location.reload();
        } else {
            alert('Lỗi xóa ảnh');
        }
    })
    .catch(error => console.error('Error:', error));
}
</script>
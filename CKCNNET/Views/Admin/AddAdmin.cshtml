@{
    ViewData["Title"] = "Thêm Admin Mới";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-shield-plus"></i> Thêm Admin Mới
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Lỗi!</strong> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>Thành công!</strong> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" class="needs-validation">
                        <div class="mb-3">
                            <label for="username" class="form-label">
                                <i class="bi bi-person"></i> Username
                            </label>
                            <input type="text" class="form-control" id="username" name="username" 
                                   placeholder="Nhập username" required>
                            <div class="form-text">Tên đăng nhập phải là duy nhất</div>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">
                                <i class="bi bi-envelope"></i> Email
                            </label>
                            <input type="email" class="form-control" id="email" name="email" 
                                   placeholder="Nhập email" required>
                            <div class="form-text">Email phải là duy nhất</div>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">
                                <i class="bi bi-lock"></i> Mật khẩu
                            </label>
                            <input type="password" class="form-control" id="password" name="password" 
                                   placeholder="Nhập mật khẩu (tối thiểu 8 ký tự)" required>
                            <div class="form-text">Mật khẩu phải chứa ít nhất 8 ký tự</div>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">
                                <i class="bi bi-lock-check"></i> Xác nhận mật khẩu
                            </label>
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" 
                                   placeholder="Nhập lại mật khẩu" required>
                        </div>

                        <div class="mb-3">
                            <label for="phoneNumber" class="form-label">
                                <i class="bi bi-telephone"></i> Số điện thoại
                            </label>
                            <input type="text" class="form-control" id="phoneNumber" name="phoneNumber" 
                                   placeholder="Nhập số điện thoại (tùy chọn)">
                        </div>

                        <hr>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1">
                                <i class="bi bi-check-circle"></i> Thêm Admin
                            </button>
                            <a href="@Url.Action("AdminManagement")" class="btn btn-secondary flex-grow-1">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </form>

                    <div class="alert alert-info mt-3">
                        <strong><i class="bi bi-info-circle"></i> Lưu ý:</strong>
                        <ul class="mb-0 ms-2">
                            <li>Username phải là duy nhất và không để trống</li>
                            <li>Email phải hợp lệ và là duy nhất</li>
                            <li>Mật khẩu tối thiểu 8 ký tự</li>
                            <li>Xác nhận mật khẩu phải khớp với mật khẩu</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

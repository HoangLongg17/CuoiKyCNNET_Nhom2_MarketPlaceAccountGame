@model IEnumerable<PurchaseReport>

@{
    ViewData["Title"] = "Báo cáo mua hàng";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>
                <i class="bi bi-exclamation-triangle"></i> Báo cáo mua hàng
            </h2>
            <p class="text-muted">Quản lý các báo cáo từ người mua</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                <i class="bi bi-list-ul"></i> Danh sách báo cáo (Tổng: @Model.Count())
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th width="8%">ID</th>
                                <th width="15%">Người báo cáo</th>
                                <th width="20%">Lý do</th>
                                <th width="15%">Game/Seller</th>
                                <th width="12%">Trạng thái</th>
                                <th width="15%">Ngày báo cáo</th>
                                <th width="15%">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary">@report.Id</span>
                                    </td>
                                    <td>
                                        <strong>@report.Buyer?.Username</strong>
                                        <br>
                                        <small class="text-muted">@report.Buyer?.Email</small>
                                    </td>
                                    <td>
                                        @report.Reason
                                    </td>
                                    <td>
                                        <strong>@report.Purchase?.GameAccount?.Game?.Name</strong>
                                        <br>
                                        <small class="text-muted">Seller: @report.Purchase?.GameAccount?.Seller?.Username</small>
                                    </td>
                                    <td>
                                        @if (report.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">⏳ Chờ xét duyệt</span>
                                        }
                                        else if (report.Status == "Under Review")
                                        {
                                            <span class="badge bg-info">🔍 Đang xem xét</span>
                                        }
                                        else if (report.Status == "Resolved")
                                        {
                                            <span class="badge bg-success">✅ Đã giải quyết</span>
                                        }
                                        else if (report.Status == "Dismissed")
                                        {
                                            <span class="badge bg-secondary">❌ Bác bỏ</span>
                                        }
                                    </td>
                                    <td>
                                        @report.ReportedDate.ToString("dd/MM/yyyy HH:mm")
                                        @if (report.ResolvedDate.HasValue)
                                        {
                                            <br>
                                            <small class="text-muted">Xử lý: @report.ResolvedDate.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-info" data-bs-toggle="modal" 
                                                data-bs-target="#reportDetailModal@(report.Id)">
                                            👁️ Chi tiết
                                        </button>
                                    </td>
                                </tr>

                                <!-- Detail Modal -->
                                <div class="modal fade" id="reportDetailModal@(report.Id)" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-lg modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header bg-warning">
                                                <h5 class="modal-title">⚠️ Chi tiết báo cáo #@report.Id</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="row mb-4">
                                                    <div class="col-md-6">
                                                        <h6>👤 Người báo cáo</h6>
                                                        <p class="mb-1"><strong>@report.Buyer?.Username</strong></p>
                                                        <p class="mb-1"><small>Email: @report.Buyer?.Email</small></p>
                                                        <p><small>SĐT: @report.Buyer?.PhoneNumber</small></p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <h6>🛍️ Đơn mua #@report.Purchase?.Id</h6>
                                                        <p class="mb-1"><strong>@report.Purchase?.GameAccount?.Game?.Name</strong></p>
                                                        <p class="mb-1"><small>Giá: <span class="text-success fw-bold">@report.Purchase?.Amount.ToString("N0") VND</span></small></p>
                                                        <p><small>Ngày mua: @report.Purchase?.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</small></p>
                                                    </div>
                                                </div>

                                                <hr>

                                                <div class="mb-4">
                                                    <h6>👤 Seller bị báo cáo</h6>
                                                    <p class="mb-1"><strong>@report.Purchase?.GameAccount?.Seller?.Username</strong></p>
                                                    <p class="mb-1"><small>Email: @report.Purchase?.GameAccount?.Seller?.Email</small></p>
                                                    <p class="mb-1"><small>SĐT: @report.Purchase?.GameAccount?.Seller?.PhoneNumber</small></p>
                                                    @if (!string.IsNullOrEmpty(report.Purchase?.GameAccount?.Seller?.BankAccount))
                                                    {
                                                        <p class="mb-0">
                                                            <small>
                                                                STK: <span class="badge bg-secondary">@report.Purchase.GameAccount.Seller.BankAccount</span>
                                                                <br>
                                                                Chủ TK: @report.Purchase.GameAccount.Seller.BankAccountHolder
                                                            </small>
                                                        </p>
                                                    }
                                                </div>

                                                <hr>

                                                <div class="mb-4">
                                                    <h6>🚩 Nội dung báo cáo</h6>
                                                    <p class="mb-2"><strong>Lý do:</strong> @report.Reason</p>
                                                    <p><strong>Mô tả:</strong></p>
                                                    <div class="border-start ps-3 text-muted">
                                                        @report.Description
                                                    </div>
                                                </div>

                                                @if (!string.IsNullOrEmpty(report.AdminNote))
                                                {
                                                    <hr>
                                                    <div class="mb-4">
                                                        <h6>📌 Ghi chú của Admin</h6>
                                                        <div class="border-start border-info ps-3">
                                                            @report.AdminNote
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="modal-footer">
                                                @if (report.Status == "Pending" || report.Status == "Under Review")
                                                {
                                                    <form method="post" action="@Url.Action("ApproveReport", "Admin")" style="display:inline;">
                                                        <input type="hidden" name="reportId" value="@report.Id" />
                                                        <button type="submit" class="btn btn-success" onclick="return confirm('Duyệt báo cáo này?\n\nAdmin sẽ liên hệ seller để yêu cầu hoàn tiền.');">
                                                            ✅ Duyệt báo cáo
                                                        </button>
                                                    </form>
                                                    <form method="post" action="@Url.Action("DismissReport", "Admin")" style="display:inline;">
                                                        <input type="hidden" name="reportId" value="@report.Id" />
                                                        <button type="submit" class="btn btn-danger" onclick="return confirm('Bác bỏ báo cáo này?');">
                                                            ❌ Bác bỏ
                                                        </button>
                                                    </form>
                                                }
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">Không có báo cáo nào</p>
                </div>
            }
        </div>
        <div class="card-footer bg-light">
            <small class="text-muted">
                <i class="bi bi-info-circle"></i> 
                Tổng báo cáo: <strong>@Model.Count()</strong> | 
                Chờ xét duyệt: <strong>@Model.Count(r => r.Status == "Pending")</strong> |
                Đã giải quyết: <strong>@Model.Count(r => r.Status == "Resolved")</strong>
            </small>
        </div>
    </div>
</div>